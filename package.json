{
  "name": "@rc-component/dom-align",
  "version": "2.0.1",
  "description": "📐 DOM alignment utility for positioning one element against another.",
  "keywords": [
    "react",
    "react-component",
    "dom-align"
  ],
  "homepage": "http://github.com/react-component/dom-align",
  "bugs": {
    "url": "http://github.com/react-component/dom-align/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:react-component/dom-align.git"
  },
  "license": "MIT",
  "main": "./lib/index",
  "module": "./es/index",
  "types": "./lib/index.d.ts",
  "files": [
    "es",
    "lib"
  ],
  "scripts": {
    "build": "dumi build",
    "compile": "father build",
    "lint": "eslint src/ docs/ --ext .tsx,.ts,.jsx,.js",
    "prepublishOnly": "npm run compile && rc-np",
    "prettier": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "start": "dumi dev",
    "test": "cypress run --component && echo ''",
    "test:ci": "cypress run --component --record --key $CYPRESS_RECORD_KEY",
    "tsc": "tsc --noEmit"
  },
  "nyc": {
    "exclude": [
      "**/node_modules/**/*",
      "**/cypress/**/*"
    ],
    "excludeAfterRemap": true,
    "reporter": [
      "text",
      "lcov"
    ]
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7"
  },
  "devDependencies": {
    "@cypress/code-coverage": "~3.12.45",
    "@rc-component/father-plugin": "^2.2.0",
    "@rc-component/np": "^1.0.4",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@umijs/fabric": "^4.0.1",
    "cypress": "^13.13.3",
    "dumi": "^2.4.38",
    "eslint": "^9.39.4",
    "father": "^4.6.24",
    "jsonp": "^0.2.1",
    "markdown-it": "^14.1.0",
    "next": "~14.2.6",
    "normalize.css": "^8.0.1",
    "prettier": "^3.9.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "swc-plugin-coverage-instrument": "0.0.21",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=14.x"
  },
  "publishConfig": {
    "access": "public"
  }
}
