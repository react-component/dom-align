{
  "compilerOptions": {
    "target": "esnext",
    "strict": false,
    "types": ["node", "jest"],
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./src/*"],
      "@@/*": ["./src/.umi/*"],
      "@rc-component/dom-align": ["./src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".dumirc.ts"]
}
